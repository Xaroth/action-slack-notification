{
  "name": "slack-notification",
  "version": "2.0.0",
  "author": "Steven 'Xaroth' Noorbergen",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "bugs": {
    "url": "https://github.com/xaroth/action-slack-notification/issues"
  },
  "homepage": "https://github.com/xaroth/action-slack-notification#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xaroth/action-slack-notification"
  },
  "main": "src/main.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "ncc build src/main.ts",
    "dev": "ncc build --watch src/main.ts",
    "format": "oxfmt",
    "test": "vitest",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint src/",
    "test:unit": "vitest run --coverage",
    "test:build": "ncc build -C -q src/main.ts",
    "commit:format": "oxfmt --check"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@slack/web-api": "^8.0.0",
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pre-commit": "^2.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pre-commit": [
    "commit:format"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "pre-commit",
      "unrs-resolver"
    ]
  }
}
